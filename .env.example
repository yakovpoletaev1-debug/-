# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ Claude API: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Как бот себя называет в инструкциях (имя/роль)
BOT_PERSONA=Помощник марафона
# Модель и «усилие» (low — быстрее и дешевле, medium/high — вдумчивее)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Папка с базой знаний (.md и .txt файлы)
KNOWLEDGE_DIR=data/knowledge
# Экспорт чата из Telegram Desktop (result.json) — бот учится на нём стилю ответов
CHAT_EXPORT_PATH=data/chat_export/result.json
# Чьи ответы брать как образец (имена или from_id через запятую). Пусто — все.
EXPERT_AUTHORS=
# Сколько примеров ответов брать из экспорта
MAX_EXAMPLES=150
# Сколько последних сообщений чата бот видит как контекст
HISTORY_SIZE=30
# Ограничить бота конкретными чатами (id через запятую). Пусто — любые чаты.
ALLOWED_CHAT_IDS=
# Пауза «печатает…» перед ответом, чтобы не отвечать мгновенно
HUMAN_DELAY=true
